# Judge endpoint (OpenAI-compatible). Copy this file to .env and fill it in.
# .env is git-ignored. Never commit it. See docs/SETUP.md, step 5.
# Never set ANTHROPIC_API_KEY here or in the shell that runs the benchmark.

MARTIAN_BASE_URL=https://openrouter.ai/api/v1
MARTIAN_API_KEY=
# Check the provider's model list for the exact id.
MARTIAN_MODEL=anthropic/claude-sonnet-4.5

# The benchmark's step 1 reads PR data through the GitHub CLI.
# Leave these commented out to use your existing `gh auth login` session.
# GH_TOKEN=
# GITHUB_TOKEN=
